# === CONFIGURAÇÕES GERAIS E SEGURANÇA ===
# Bloqueia chaves de API, senhas e credenciais (CRÍTICO)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local.txt
deploy_links*.txt

# === PYTHON ===
# Pastas do ambiente virtual (onde ficam as bibliotecas instaladas)
venv/
.venv/
env/
ENV/

# Arquivos temporários e compilados do Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
.pytest_cache/

# === REACT / NODE.js ===
# Pasta gigante de dependências do JavaScript (nunca envie ao GitHub)
node_modules/

# Pastas de compilação/build final do React
build/
dist/

# Logs de erro do NPM ou Yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === SISTEMA OPERACIONAL ===
.DS_Store
Thumbs.db

# === BANCO DE DADOS LOCAL ===
*.db
*.sqlite3
